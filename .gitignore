# Ignore trained models (karena ukurannya terlalu besar untuk GitHub)
*.pkl
*.h5
*.joblib
model_metadata.json

# Ignore data files (jika ada data lokal yang besar)
*.csv
*.xlsx
*.parquet

# ==========================================
# Python Cache & Virtual Environments
# ==========================================
